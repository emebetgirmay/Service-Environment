# Example environment file for production deployment.
# Copy to .env and fill in real values:
#   cp .env.example .env

# Your Docker Hub username (owner of the published images).
DOCKERHUB_USERNAME=your-dockerhub-username

# Application name — used as the image-name prefix
APP_NAME=service-environment

# Image tag to deploy. Always a commit-pinned tag published by CI (never "latest").
IMAGE_TAG=sha-a1b2c3d
