# Example environment file for production deployment.
#
# Copy to .env and fill in real values (the real .env is gitignored and must
# never be committed):
#
#   cp .env.example .env
#
# These variables are consumed by docker-compose.prod.yml and scripts/deploy.sh
# to resolve the commit-pinned images published to Docker Hub by CI.

# Your Docker Hub username (owner of the published images).
DOCKERHUB_USERNAME=your-dockerhub-username

# Application name — used as the image-name prefix, e.g.
# <DOCKERHUB_USERNAME>/<APP_NAME>-service-a. Matches the GitHub repository name.
APP_NAME=service-environment

# Image tag to deploy. Always a commit-pinned tag published by CI (never "latest").
IMAGE_TAG=sha-a1b2c3d
